<!-- ══════════════════════════════════════════════════════════
     SECTION 1 – HERO
══════════════════════════════════════════════════════════ -->
<style>
/* ─── TOKENS ─────────────────────────────────────────────── */:root
{
	--navy: #081d38;
	--orange: #ff4a29;
	--light-bg: #dce9f5;
	--white: #ffffff;
	--text-dark: #1a1a2e;
	--text-mid: #444;
	--text-light: #888;
	--border: #c8d8e8;
	--font-head: 'Montserrat', sans-serif;
	--font-body: 'Open Sans', sans-serif;
}

/* ─── RESET ──────────────────────────────────────────────── */
*,
*::before,
*::after {
	box-sizing: border-box;
	margin: 0;
	padding: 0;
}
body {

	background: var(--white);
	color: var(--text-dark);
}
img {
	display: block;
	max-width: 100%;
}

/* ══════════════════════════════════════════════════════════
       SECTION 1 – HERO / SAVE THE DATE
    ══════════════════════════════════════════════════════════ */

.hero__overlay {
	position: absolute;
	inset: 0;
	background: linear-gradient(to right, rgba(8,29,56,.93) 55%, rgba(8,29,56,.55) 100%);
}
.hero__inner {
	position: relative;
	max-width: 860px;
	margin: 0 auto;
	padding: 36px 24px 40px;
}
.hero__logo {
	position: absolute;
	top: 24px;
	right: 24px;
	text-align: right;
}
.hero__logo-badge {
	display: inline-block;
	border: 2px solid var(--white);
	border-radius: 50%;
	padding: 6px;
	width: 72px;
	height: 72px;
	background: rgba(255, 255, 255, 0.08);
}
.hero__logo-text {
	color: var(--white);

	font-size: 10px;
	font-weight: 700;
	letter-spacing: 0.08em;
	text-transform: uppercase;
	line-height: 1.3;
	margin-top: 6px;
}
.hero__logo-text span {
	color: var(--orange);
}

.hero__tag {
	color: var(--white);

	font-size: 10px;
	font-weight: 700;
	letter-spacing: 0.18em;
	text-transform: uppercase;
	margin-bottom: 8px;
	opacity: .7;
}

.page-diaspora2 #banner-title {
	display: none;
}
.page-diaspora2 #contact---us {
	display: none;
}

.page-diaspora2 .bg-white.shadow-sm.header--menu {
	display: none;
}
.page-diaspora2 .section---filter-block {
	display: none;
}
.page-diaspora2 .bg-dark.text-light.py-5 {
	display: none;
}
.hero__title {
	color: var(--white);

	font-size: clamp(42px, 7vw, 76px);
	font-weight: 900;
	text-transform: uppercase;
	line-height: 1;
	letter-spacing: -0.01em;
	margin-bottom: 18px;
}
.hero__subtitle-label {
	color: var(--white);

	font-size: 13px;
	font-weight: 700;
	text-transform: uppercase;
	letter-spacing: 0.06em;
	margin-bottom: 6px;
}
.hero__subtitle-label span {
	color: var(--orange);
}
.hero__subtitle-body {
	color: var(--white);

	font-size: 13px;
	font-weight: 700;
	text-transform: uppercase;
	letter-spacing: 0.06em;
	margin-bottom: 32px;
}
.hero__divider {
	width: 100%;
	height: 3px;
	background: linear-gradient(to right, var(--orange), transparent);
	margin-bottom: 28px;
}
.hero__meta {
	display: flex;
	flex-direction: column;
	gap: 10px;
}
.hero__meta-row {
	display: flex;
	align-items: flex-start;
	gap: 12px;
}
.hero__meta-icon {
	width: 20px;
	height: 20px;
	flex-shrink: 0;
	margin-top: 1px;
}
.hero__meta-icon svg {
	width: 20px;
	height: 20px;
	fill: none;
	stroke: var(--orange);
	stroke-width: 1.8;
}
.hero__meta-text {
	color: var(--white);

	font-size: 13px;
	font-weight: 700;
	text-transform: uppercase;
	letter-spacing: 0.06em;
	line-height: 1.5;
}

.hero__partner {
	position: absolute;
	bottom: 28px;
	right: 24px;
	text-align: right;
}
.hero__partner-label {
	color: var(--white);
	font-size: 9px;
	font-style: italic;
	opacity: .7;
	margin-bottom: 6px;
}
.hero__partner-badge {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	background: rgba(255, 255, 255, 0.12);
	border: 1px solid rgba(255, 255, 255, 0.3);
	border-radius: 6px;
	padding: 8px 14px;
	gap: 8px;
}
.hero__partner-badge .badge-num {
	font-size: 28px;
	font-weight: 900;
	color: var(--white);
	line-height: 1;
}
.hero__partner-badge .badge-word {
	font-size: 10px;
	font-weight: 700;
	text-transform: uppercase;
	color: var(--white);
	letter-spacing: 0.05em;
	line-height: 1.2;
}

/* ══════════════════════════════════════════════════════════
       SECTION 2 – INTERVENANTS
    ══════════════════════════════════════════════════════════ */
.speakers {
	background: #e5fff1;
	padding: 48px 24px 56px;
}
.speakers__inner {
	max-width: 860px;
	margin: 0 auto;
}
.speakers__heading {
	text-align: center;
	font-size: 18px;
	font-weight: 800;
	text-transform: uppercase;

	color: var(--orange);
	margin-bottom: 36px;
}
.speakers__grid {
	display: grid;
	grid-template-columns: repeat(4, 1fr);
	gap: 28px 16px;
}
.speaker-card {
	text-align: center;
	position: relative;
}
.speaker-card__photo-wrap {
	position: relative;
	width: 200px;
	height: 200px;
	margin: 0 auto 12px;
}
.speaker-card__photo {
	width: 200px;
	height: 200px;
	border-radius: 50%;
	object-fit: cover;
	border: 3px solid var(--navy);
	background: #c8d8e8;
}
.speaker-card__photo-placeholder img {
	width: 100%;
	height: 100%;
	border-radius: 50%;

}

.speaker-card__photo-placeholder {
	width: 200px;
	height: 200px;
}
.speaker-card__badge {
	position: absolute;
	top: -6px;
	right: -6px;
	background: var(--orange);
	color: var(--white);
	font-size: 7px;
	font-weight: 800;
	text-transform: uppercase;
	letter-spacing: 0.1em;
	padding: 3px 6px;
	border-radius: 4px;
	transform: rotate(12deg);
	white-space: nowrap;
}
.speaker-card__name {
	font-size: 11px;
	font-weight: 800;
	text-transform: uppercase;
	letter-spacing: 0.06em;
	color: var(--navy);
	margin-bottom: 4px;
}
.speaker-card__role {
	font-size: 10px;
	color: var(--text-mid);
	line-height: 1.4;
}

/* ══════════════════════════════════════════════════════════
       SECTION 3 – PROGRAMME
    ══════════════════════════════════════════════════════════ */
.programme {
	background: var(--white);
	padding: 52px 24px 60px;
}
.footer__dia {
	width: 100%;
	text-align: center;
	padding-bottom: 1%;
}
.programme__inner {
	max-width: 860px;
	margin: 0 auto;
}
.programme__heading {
	text-align: center;
	font-size: 18px;
	font-weight: 800;
	text-transform: uppercase;

	color: var(--orange);
	margin-bottom: 36px;
}
.programme__list {
	display: flex;
	flex-direction: column;
	gap: 0;
}
{# .programme-item {
	padding: 18px 0;
	border-bottom: 1px solid var(--border);
}
.programme-item:first-child {
	border-top: 1px solid var(--border);
} #}


.programme-item {
	padding: 18px 0;
	border-bottom: 1px solid var(--border);
	border-bottom: 2px solid;
	border-image: linear-gradient( to right, #ff3d00 60%, transparent 100% ) 1;
	display: inline-block;
}
.programme-item:first-child {
	border-top: 1px solid var(--border);
	border-bottom: 2px solid;
	border-image: linear-gradient( to right, #ff3d00 60%, transparent 100% ) 1;
	display: inline-block;
}


.programme-item__time {
	font-size: 12px;
	font-weight: 700;
	color: var(--orange);
	text-transform: uppercase;
	letter-spacing: 0.04em;
	margin-bottom: 6px;
}
.programme-item__label {
	font-size: 14px;
	color: var(--text-dark);
	line-height: 1.5;
}
.programme-item__label .prog-highlight {
	color: var(--orange);
	font-weight: 600;
}

/* ══════════════════════════════════════════════════════════
       SECTION 4 – FORM / INSCRIVEZ-VOUS
    ══════════════════════════════════════════════════════════ */
.register {
	background: var(--white);
	padding: 0 24px 60px;
}
.register__inner {
	max-width: 860px;
	margin: 0 auto;
}
.register__heading {
	text-align: center;
	font-size: 18px;
	font-weight: 800;
	text-transform: uppercase;

	color: var(--orange);
	margin-bottom: 28px;
}
.speaker-card__name {
  color: var(--orange);
}
.register__card {
	background: var(--navy);
	border-radius: 16px;
	padding: 36px 32px 40px;
	max-width: 560px;
	margin: 0 auto;
}
.register__fields {
	display: flex;
	flex-direction: column;
	gap: 14px;
}
.register__row {
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: 14px;
}
.register__field {
	background: rgba(255, 255, 255, 0.06);
	border: 1px solid rgba(255, 255, 255, 0.18);
	border-radius: 8px;
	padding: 14px 16px;
	color: rgba(255, 255, 255, 0.5);
	font-size: 13px;
	outline: none;
	transition: border-color 0.2s;
	width: 100%;
}
.register__field::placeholder {
	color: rgba(255, 255, 255, 0.45);
}
.register__field:focus {
	border-color: var(--orange);
}
.register__btn {
	background: var(--orange);
	color: var(--white);
	font-size: 14px;
	font-weight: 700;
	text-transform: uppercase;
	letter-spacing: 0.1em;
	border: none;
	border-radius: 8px;
	padding: 16px;
	width: 100%;
	cursor: pointer;
	margin-top: 6px;
	transition: opacity 0.2s;
}
.register__btn:hover {
	opacity: .88;
}

/* ══════════════════════════════════════════════════════════
       SECTION 5 – FOOTER
    ══════════════════════════════════════════════════════════ */
.footer {
	background: var(--white);
	border-top: 1px solid var(--border);
	padding: 20px 24px;
	text-align: center;
}
.footer__copy {
	font-size: 11px;
	color: var(--text-light);
	letter-spacing: 0.04em;
}
.page-diaspora2 .la_slider_members_elements {
	padding: 0;
}

.speakers {
	margin-top: 0;
}

.programme .container {
	padding: 0 60px;
}

.register__card form label,.register__card form svg {
  display: none !important;
}
.register__card form {
}
.register__card form .wrapper_submit input {
  width: 100%;
  padding: 10px;
  border-radius: 50px !important;
  background: var(--orange);
  border: 0;
  color: #fff;
}
.register__heading {
  font-size: 30px;
  font-weight: bold;
}
.programme__heading {
  font-size: 30px;
}
.speakers__heading {
  font-size: 30px;
}

.speaker-card__name {
  color: var(--orange);
  font-size: 18px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin: 0;
  border-bottom: 2px solid;
  border-image: linear-gradient( to right, #ff3d00 60%, transparent 100% ) 1;
  display: inline-block;
  padding-bottom: 0;
  border-radius: 9px;
}
.speaker-card__role {
  padding-top: 9px;
}
.speaker-card__photo-placeholder {
  width: 200px;
  height: 200px;
  border-radius: 50%;
  border: 4px solid #1a3a5c;
  padding: 4px;
  background: #ffffff;
  box-sizing: border-box;
}

.speaker-card__photo-placeholder img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  object-fit: cover;
  display: block;
}
/* ─── RESPONSIVE ─────────────────────────────────────────── */
@media(max-width: 640px) {
	.speakers__grid {
		grid-template-columns: repeat(2, 1fr);
	}
	.register__row {
		grid-template-columns: 1fr;
	}
	.hero__partner {
		position: static;
		margin-top: 24px;
		text-align: left;
	}
}
@media(max-width: 400px) {
	.speakers__grid {
		grid-template-columns: repeat(2, 1fr);
	}
