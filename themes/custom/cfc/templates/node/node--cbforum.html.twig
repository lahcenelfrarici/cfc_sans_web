	<script>
		$(function () {
$('#viewAllBtn').on('click', function () {
var $btn = $(this);
var isOpen = $btn.data('state') === 'open';

if (isOpen) {
$('.speaker-card.hidden-speaker').hide();
$btn.data('state', 'closed').text('view all speakers ⌄');
} else {
$('.speaker-card.hidden-speaker').show();
$btn.data('state', 'open').text('view less ⌃');
}
});
});
jQuery(function ($) {
var $speakerDetailPanel = $('#speakerPanel');
var $speakerDetailOverlay = $('#speakerOverlay');
var $pageBody = $('body');

function openSpeakerDetail($clickedCard) {
var $cardPhoto = $clickedCard.find('.avatar-slot img');
var speakerName = $clickedCard.find('.sp-name').text().trim();
var speakerRole = $clickedCard.find('.sp-role').text().trim();
var speakerBio = $clickedCard.find('.sp-tooltip').text().trim();

$('#speakerPhoto').attr('src', $cardPhoto.attr('src') || '').attr('alt', speakerName);
$('#speakerName').text(speakerName);
$('#speakerRole').text(speakerRole);
$('#speakerBio').text(speakerBio);

$speakerDetailPanel.addClass('active');
$speakerDetailOverlay.addClass('active');
$pageBody.addClass('panel-open');
}

function closeSpeakerDetail() {
$speakerDetailPanel.removeClass('active');
$speakerDetailOverlay.removeClass('active');
$pageBody.removeClass('panel-open');
}

$(document).on('click', '.speaker-card', function () {
openSpeakerDetail($(this));
});

$('#speakerClose, #speakerOverlay').on('click', closeSpeakerDetail);

$(document).on('keydown', function (e) {
if (e.key === 'Escape')
closeSpeakerDetail();



});
});
$(document).ready(function () {
$('.bio-toggle').on('click', function () {
var $btn = $(this);
var $full = $btn.closest('.fs-bio').find('.bio-full');

$full.slideToggle(200, function () {
var isVisible = $full.is(':visible');
$btn.text(isVisible ? '- Show less' : '+ Show more');
});
});
});
	</script>
