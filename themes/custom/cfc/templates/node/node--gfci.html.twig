{#
/**
 * @file
 * node--gfci.html.twig
 *
 * Template for the GFCI (Global Financial Centres Index) node type.
 * Includes Google Analytics (gtag.js) injected into <head> via attach_library
 * using the #attached html_head method rendered here in Twig.
 */
#}

{# ============================================================
   GOOGLE ANALYTICS — injected into <head> via Twig attach hack.
   Because node templates render inside <body>, we use the
   drupal_add_html_head() equivalent by attaching to the page's
   #attached html_head array in the preprocess hook.

   If you prefer a pure-Twig approach (no preprocess hook needed),
   uncomment the <script> blocks below and note that Drupal's
   BigPipe / render pipeline will still place them in <body>.
   The RECOMMENDED approach is the preprocess hook in your
   .theme file (see bottom of this file).
   ============================================================ #}

{% set gtag_id = 'G-9WWD1TRBQN' %}

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">

    {# ── Google Analytics ── #}
    <script async src="https://www.googletagmanager.com/gtag/js?id={{ gtag_id }}"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', '{{ gtag_id }}');
    </script>
    {# ── End Google Analytics ── #}

    <meta name="description" content="Encourage users to vote in the Global Financial Centres Index with a premium landing page that highlights Casablanca's financial significance and global influence.">
    <meta name="title" content="Corporate Landing Page Design">
    <meta name="robots" content="noindex">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content="https://tech-tawny-41071708.figma.site/">
    <meta name="twitter:title" content="Corporate Landing Page Design">
    <meta name="twitter:description" content="Encourage users to vote in the Global Financial Centres Index with a premium landing page that highlights Casablanca's financial significance and global influence.">
    <meta property="og:title" content="Corporate Landing Page Design">
    <meta property="og:description" content="Encourage users to vote in the Global Financial Centres Index with a premium landing page that highlights Casablanca's financial significance and global influence.">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://tech-tawny-41071708.figma.site/">
    <meta property="og:site_name" content="Corporate Landing Page Design">
    <title>Corporate Landing Page Design</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <style>
      @layer figoverridable {
        :root { font-synthesis: none; }
      }
      @layer figutils {
        :root {
          --banner-height: 48px;
          --banner-height-v2: 40px;
          --full-height-with-banner: calc(100dvh - var(--banner-height));
