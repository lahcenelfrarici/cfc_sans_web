                <linearGradient id="paint2_linear_6507_14111" x1="66.104" y1="74.612" x2="81.5494" y2="72.899" gradientunits="userSpaceOnUse">
                  <stop stop-color="#009681"/>
                  <stop offset="1" stop-color="#007565"/>
                </linearGradient>
              </defs>
            </svg>
            <p>
              {{'It looks like there are no members in this industry and country right now.<br>
              Check back later to explore new additions to our community!'|t}}
            </p>
