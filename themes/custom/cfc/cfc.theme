/**
 * Implements hook_route_alter().
 */
function cfc_preprocess_html(array &$variables)
{
  // Get the current path
  $path = \Drupal::service('path.current')->getPath();

  // Convert internal path to alias (like /node/1 => /about)
  $alias = \Drupal::service('path_alias.manager')->getAliasByPath($path);

  // Sanitize the alias to be used as a CSS class
  $class = str_replace('/', '-', trim($alias, '/'));
  $class = Html::getClass($class);

  // Add it to body classes
  if (!empty($class)) {
    $variables['attributes']['class'][] = 'page-' . $class;
  }
}

